# คัดลอกเป็น .env แล้วใส่ค่าจริง (chmod 600 .env) — ห้าม commit .env
# ห้ามใช้ key/sub-account/bot ร่วมกับ PRS bot

# Anthropic (ตั้ง monthly spend limit ที่ console ด้วย)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Alpaca — PAPER เท่านั้นใน Phase 0–5
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# OKX sub-account ของระบบนี้: Trade only, ปิด Withdraw, IP whitelist = VPS
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# Telegram bot #1 — notify.py (send-only) + คำสั่ง /halt ของ fund.py
TG_TOKEN=
TG_CHAT_ID=
# Telegram bot #2 — freqtrade เท่านั้น (polling แยก ห้ามใช้ token เดียวกับ TG_TOKEN)
TG_FT_TOKEN=

# ใช้โดย TradingAgents (คั่นหลาย key ด้วย comma)
TAVILY_API_KEYS=

# path (ค่า default ใช้ได้)
LEDGER_PATH=data/ledger.sqlite
HALT_FLAG_PATH=data/halt.flag

# Trade journal Google Sheet (คนละ project/service account กับ PRS) — JSON อยู่นอก repo, chmod 600
GOOGLE_SA_JSON_PATH=
JOURNAL_SHEET_ID=
